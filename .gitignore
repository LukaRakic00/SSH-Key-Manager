# ---------------------------------------------------------------------------
# SSH keys: never commit private OR public keys to this project.
# Keys belong in %USERPROFILE%\.ssh, not in the repository.
# ---------------------------------------------------------------------------
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.pub
*.pem
*.key
*.ppk
*.p12
*.pfx
*_rsa
*_ed25519
*_ecdsa

# Local SSH configuration, known hosts and backups created by ssh_manager.py
.ssh/
/config
ssh_config
known_hosts
known_hosts.old
authorized_keys
authorized_keys2
config.ssh-manager-backup-*
.config.*.tmp

# Secrets and credentials
.env
.env.*
*.secret
*.secrets
*.token
secrets/
credentials*
hosts.yml

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editors and operating systems
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
